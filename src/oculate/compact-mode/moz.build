XPIDL_SOURCES += [
    "nsIOculateMouseTracker.idl",
]

EXPORTS.mozilla += [
    "OculateMouseTracker.h",
    "OculateMouseTrackerInternal.h",
]

SOURCES += [
    "OculateMouseTracker.cpp",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

LOCAL_INCLUDES += [
    "/widget",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    SOURCES += ["OculateMouseTrackerCocoa.mm"]
    LOCAL_INCLUDES += [
        "/widget/cocoa",
        "/xpcom/base",
    ]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    SOURCES += ["OculateMouseTrackerWin.cpp"]

FINAL_LIBRARY = "xul"
XPIDL_MODULE = "oculate_compact_mode"

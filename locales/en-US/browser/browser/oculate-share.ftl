oculate-share-space =
    .label = Share Space…
oculate-share-folder =
    .label = Share Folder…
oculate-share-split-view =
    .label = Share Split View…

oculate-share-link-copied-toast = Share link copied!
oculate-share-link-expires-description = Anyone with the link can open it until { $date }
oculate-share-link-permanent-description = Anyone with the link can open it


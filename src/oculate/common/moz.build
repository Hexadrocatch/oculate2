EXTRA_JS_MODULES += [
    "sys/OculateActorsManager.sys.mjs",
    "sys/OculateCustomizableUI.sys.mjs",
    "sys/OculateUIMigration.sys.mjs",
]

if CONFIG["MOZ_PROFILE_GENERATE"] or CONFIG["MOZ_CS_PROFILE_GENERATE"]:
    EXTRA_JS_MODULES += [
        "sys/OculatePGOTraining.sys.mjs",
    ]

EXTRA_JS_MODULES.oculate += [
    "modules/OculateToasts.mjs",
    "modules/OculateVerticalTabsManager.mjs",
]

EXTRA_JS_MODULES.oculate.ui += [
    "sys/ui/OculateProgressBar.sys.mjs",
    "sys/ui/OculateUIComponent.sys.mjs",
]

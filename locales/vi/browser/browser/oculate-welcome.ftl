oculate-welcome-default-browser-description = Links from other apps will open in { -brand-short-name }. You can always change this later.
oculate-welcome-set-default-browser = <strong>YES</strong>, make { -brand-short-name } default.
oculate-welcome-dont-set-default-browser = <strong>NO</strong>, still exploring my options.
oculate-welcome-default-search-title = Công cụ tìm kiếm mặc định của bạn là?

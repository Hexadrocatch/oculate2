XPIDL_SOURCES += [
    "nsIOculateDragAndDrop.idl",
]

EXPORTS.mozilla += [
    "nsOculateDragAndDrop.h",
]

SOURCES += [
    "nsOculateDragAndDrop.cpp",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    SOURCES += [
        "nsOculateDropLandingCocoa.mm",
        "nsOculateNativeWindowMove.mm",
    ]
elif CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]

XPCOM_MANIFESTS += [
    "components.conf",
]

include("/ipc/chromium/chromium-config.mozbuild")

LOCAL_INCLUDES += [
    "/dom/base",
    "/layout/base",
    "/widget",
]

FINAL_LIBRARY = "xul"
XPIDL_MODULE = "oculate_dnd"
